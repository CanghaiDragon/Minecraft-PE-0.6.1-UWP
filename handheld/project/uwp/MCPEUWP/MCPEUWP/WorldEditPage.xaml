<Page
    x:Class="MCPEUWP.WorldEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
    Background="Transparent">

    <Grid Margin="42,28,42,24" Background="#20000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="HeaderText"
                       Text="World Edit"
                       Foreground="White"
                       FontSize="30"
                       HorizontalAlignment="Left" />
            <TextBlock Text="Edit saved world"
                       Foreground="#FFD0D0D0"
                       FontSize="16"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="#B0202020" Padding="18" Margin="0,0,0,12">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Folder name"
                               Foreground="White"
                               FontSize="18"
                               Margin="0,0,16,10" />
                    <TextBox x:Name="FolderNameTextBox"
                             Grid.Column="1"
                             FontSize="18"
                             Foreground="White"
                             Background="#C0000000"
                             Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1"
                               Text="World name"
                               Foreground="White"
                               FontSize="18"
                               Margin="0,0,16,10" />
                    <TextBox x:Name="WorldNameTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             FontSize="18"
                             Foreground="White"
                             Background="#C0000000"
                             Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2"
                               Text="Game mode"
                               Foreground="#FFD0D0D0"
                               FontSize="17"
                               Margin="0,0,16,8" />
                    <TextBlock x:Name="GameModeText"
                               Grid.Row="2"
                               Grid.Column="1"
                               Foreground="White"
                               FontSize="17"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3"
                               Text="World type"
                               Foreground="#FFD0D0D0"
                               FontSize="17"
                               Margin="0,0,16,8" />
                    <TextBlock x:Name="WorldTypeText"
                               Grid.Row="3"
                               Grid.Column="1"
                               Foreground="White"
                               FontSize="17"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4"
                               Text="Play time"
                               Foreground="#FFD0D0D0"
                               FontSize="17"
                               Margin="0,0,16,8" />
                    <TextBlock x:Name="PlayTimeText"
                               Grid.Row="4"
                               Grid.Column="1"
                               Foreground="White"
                               FontSize="17"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5"
                               Text="Stored size"
                               Foreground="#FFD0D0D0"
                               FontSize="17"
                               Margin="0,0,16,0" />
                    <TextBlock x:Name="StoredSizeText"
                               Grid.Row="5"
                               Grid.Column="1"
                               Foreground="White"
                               FontSize="17" />
                    </Grid>
                </Border>

                <WrapGrid HorizontalAlignment="Center"
                          MaximumRowsOrColumns="2">
                    <Button Content="Change Folder Name"
                            Click="OnChangeFolderNameClick"
                            FontSize="18"
                            Foreground="White"
                            Width="260"
                            Height="58"
                            Margin="5" />
                    <Button Content="Change World Name"
                            Click="OnChangeWorldNameClick"
                            FontSize="18"
                            Foreground="White"
                            Width="260"
                            Height="58"
                            Margin="5" />
                    <Button Content="Delete World"
                            Click="OnDeleteWorldClick"
                            FontSize="18"
                            Foreground="White"
                            Width="260"
                            Height="58"
                            Margin="5" />
                    <Button Content="Export World"
                            Click="OnExportWorldClick"
                            FontSize="18"
                            Foreground="White"
                            Width="260"
                            Height="58"
                            Margin="5" />
                </WrapGrid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="#FFFFD080"
                       FontSize="16"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,180,0" />
            <Button Content="Back"
                    Click="OnBackClick"
                    FontSize="19"
                    Foreground="White"
                    Width="150"
                    Height="58"
                    HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Page>

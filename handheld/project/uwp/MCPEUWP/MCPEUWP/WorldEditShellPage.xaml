<Page
    x:Class="MCPEUWP.WorldEditShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent"
          Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="World Edit"
                   Foreground="White"
                   FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                   FontSize="32"
                   HorizontalAlignment="Center" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="760">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Folder name"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="FolderNameValueText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="Rename"
                        Click="OnChangeFolderNameClick"
                        FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                        FontSize="18"
                        Foreground="White"
                        Width="160"
                        Height="52"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="World name"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="WorldNameValueText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="Rename"
                        Click="OnChangeWorldNameClick"
                        FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                        FontSize="18"
                        Foreground="White"
                        Width="160"
                        Height="52"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Last opened"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="LastOpenedValueText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Play time"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PlayTimeValueText"
                           Grid.Row="3"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Seed"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SeedValueText"
                           Grid.Row="4"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Game mode"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="GameModeValueText"
                           Grid.Row="5"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="World type"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="WorldTypeValueText"
                           Grid.Row="6"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />

            </Grid>

            <TextBlock x:Name="WorldIdValueText"
                       Text="Unavailable"
                       Foreground="#FFB0E0FF"
                       FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Text="Editor shell loaded."
                       Foreground="#FFFFD080"
                       FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                       FontSize="18"
                       HorizontalAlignment="Center" />
            <ProgressBar x:Name="ExportProgressBar"
                         Visibility="Collapsed"
                         IsIndeterminate="True"
                         Width="320"
                         Height="10"
                         Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="Delete"
                    Click="OnDeleteWorldClick"
                    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                    FontSize="20"
                    Foreground="White"
                    Width="180"
                    Height="60"
                    Margin="0,0,16,0" />
            <Button Content="Export"
                    Click="OnExportWorldClick"
                    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                    FontSize="20"
                    Foreground="White"
                    Width="180"
                    Height="60"
                    Margin="0,0,16,0" />
            <Button Content="Back"
                    Click="OnBackClick"
                    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                    FontSize="20"
                    Foreground="White"
                    Width="180"
                    Height="60" />
        </StackPanel>

        <Grid x:Name="SecondaryDialogOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Margin="-48"
              Visibility="Collapsed"
              Opacity="0"
              Background="#99000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFE0E0E0"
                    BorderBrush="#FF303030"
                    BorderThickness="2"
                    Padding="24">
                <StackPanel>
                    <TextBlock x:Name="SecondaryDialogTitle"
                               Text=""
                               Foreground="#FF101010"
                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SecondaryDialogMessage"
                               Text=""
                               Foreground="#FF202020"
                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                               FontSize="18"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBox x:Name="SecondaryDialogTextBox"
                             Visibility="Collapsed"
                             Width="320"
                             Height="32"
                             MinHeight="0"
                             HorizontalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="8,0,8,0"
                             FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                             FontSize="18"
                             Margin="0,18,0,0" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,24,0,0">
                        <Button x:Name="SecondaryDialogPrimaryButton"
                                Content="Save"
                                Click="OnSecondaryDialogPrimaryClick"
                                FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                                FontSize="18"
                                Foreground="#FF101010"
                                Width="180"
                                Height="56"
                                Margin="0,0,12,0" />
                        <Button x:Name="SecondaryDialogCancelButton"
                                Content="Cancel"
                                Click="OnSecondaryDialogCancelClick"
                                FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                                FontSize="18"
                                Foreground="#FF101010"
                                Width="180"
                                Height="56" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

<Page
    x:Class="MCPEUWP.WorldEditShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent"
          Padding="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="World Edit"
                   Foreground="White"
                   FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                   FontSize="32"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="820">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Folder name"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="FolderNameValueText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="Rename"
                        Click="OnChangeFolderNameClick"
                        FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                        FontSize="18"
                        Foreground="White"
                        Height="52"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="World name"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="WorldNameValueText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="Rename"
                        Click="OnChangeWorldNameClick"
                        FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                        FontSize="18"
                        Foreground="White"
                        Height="52"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Last opened"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="LastOpenedValueText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Play time"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="PlayTimeValueText"
                           Grid.Row="3"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Seed"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="SeedValueText"
                           Grid.Row="4"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Game mode"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="GameModeValueText"
                           Grid.Row="5"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="World type"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="WorldTypeValueText"
                           Grid.Row="6"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Size on disk"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="SizeOnDiskValueText"
                           Grid.Row="7"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="18"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="StorageVersion"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="StorageVersionValueText"
                           Grid.Row="8"
                           Grid.Column="1"
                           Text="Unavailable"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="14"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="9"
                           Grid.Column="0"
                           Text="PIN to start menu"
                           Foreground="White"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="16"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="StartMenuIconValueText"
                           Grid.Row="9"
                           Grid.Column="1"
                           Text="Not configured"
                           Foreground="#FFB0E0FF"
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           FontSize="16"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0" />
                <Button Grid.Row="9"
                        Grid.Column="2"
                        Content="PIN"
                        Click="OnChooseStartIconClick"
                        FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                        FontSize="16"
                        Foreground="White"
                        Height="52"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch" />

            </Grid>

            <TextBlock x:Name="WorldIdValueText"
                       Text="Unavailable"
                       Foreground="#FFB0E0FF"
                       FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Text="Editor shell loaded."
                       Foreground="#FFFFD080"
                       FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       MaxWidth="820"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <ProgressBar x:Name="ExportProgressBar"
                         Visibility="Collapsed"
                         IsIndeterminate="True"
                         Width="320"
                         Height="10"
                         Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2"
              HorizontalAlignment="Stretch"
              MaxWidth="760"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Delete"
                    Grid.Column="0"
                    Click="OnDeleteWorldClick"
                    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                    FontSize="18"
                    Foreground="White"
                    Height="60"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,6,0" />
            <Button Content="Export"
                    Grid.Column="1"
                    Click="OnExportWorldClick"
                    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                    FontSize="18"
                    Foreground="White"
                    Height="60"
                    HorizontalAlignment="Stretch"
                    Margin="6,0,6,0" />
            <Button Content="Back"
                    Grid.Column="2"
                    Click="OnBackClick"
                    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                    FontSize="18"
                    Foreground="White"
                    Height="60"
                    HorizontalAlignment="Stretch"
                    Margin="6,0,0,0" />
        </Grid>

        <Grid x:Name="SecondaryDialogOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Margin="-24,-18,-24,-18"
              Visibility="Collapsed"
              Opacity="0"
              Background="#99000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border MaxWidth="520"
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFE0E0E0"
                    BorderBrush="#FF303030"
                    BorderThickness="2"
                    Padding="24">
                <StackPanel>
                    <TextBlock x:Name="SecondaryDialogTitle"
                               Text=""
                               Foreground="#FF101010"
                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SecondaryDialogMessage"
                               Text=""
                               Foreground="#FF202020"
                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                               FontSize="18"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                     <TextBox x:Name="SecondaryDialogTextBox"
                             Visibility="Collapsed"
                              MaxWidth="320"
                             Height="32"
                             MinHeight="0"
                             HorizontalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="8,0,8,0"
                             FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                             FontSize="18"
                             Margin="0,18,0,0" />
                     <Grid HorizontalAlignment="Stretch"
                           Margin="0,24,0,0">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="*" />
                         </Grid.ColumnDefinitions>
                        <Button x:Name="SecondaryDialogPrimaryButton"
                                Content="Save"
                                 Grid.Column="0"
                                Click="OnSecondaryDialogPrimaryClick"
                                FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                                FontSize="18"
                                Foreground="#FF101010"
                                Height="56"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,6,0" />
                        <Button x:Name="SecondaryDialogCancelButton"
                                Content="Cancel"
                                 Grid.Column="1"
                                Click="OnSecondaryDialogCancelClick"
                                FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                                FontSize="18"
                                Foreground="#FF101010"
                                 Height="56"
                                 HorizontalAlignment="Stretch"
                                 Margin="6,0,0,0" />
                     </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="WorldTileIconOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Margin="-24,-18,-24,-18"
              Visibility="Collapsed"
              Background="#EE2B1B10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border MaxWidth="760"
                    Margin="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF3A281D"
                    BorderBrush="#FF8A6A4A"
                    BorderThickness="2"
                    Padding="8">
                <Frame x:Name="WorldTileIconFrame"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
            </Border>
        </Grid>
    </Grid>
</Page>

<Page
    x:Class="MCPEUWP.WorldImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
    Background="Transparent">

    <Grid Background="Transparent">
        <Grid Margin="34,22,34,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Import World"
                       FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                       Foreground="White"
                       FontSize="30"
                       HorizontalAlignment="Left" />

            <TextBlock Grid.Row="0"
                       Text="Select a .zip world archive to extract into minecraftWorlds."
                       FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                       Foreground="#FFD0D0D0"
                       FontSize="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="Choose a ZIP file to begin."
                           FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                           Foreground="#FFD0D0D0"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Border x:Name="ImportSuccessPanel"
                        Visibility="Collapsed"
                        Background="#CC203820"
                        BorderBrush="#FF80D080"
                        BorderThickness="2"
                        Padding="24"
                        Margin="0,18,0,0"
                        MaxWidth="620">
                    <StackPanel>
                        <TextBlock x:Name="ImportSuccessTitle"
                                   Text="IMPORT SUCCESS"
                                   FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                                   Foreground="#FFB0FFB0"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ImportSuccessDetails"
                                   Text=""
                                   FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="SelectZipButton"
                        Content="Select ZIP"
                        FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                        Click="OnSelectZipClick"
                        Width="170"
                        Height="54"
                        FontSize="17"
                        Foreground="White"
                        Margin="0,0,12,0" />
                <Button Content="Back"
                    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                    Click="OnBackClick"
                    Width="150"
                    Height="54"
                    FontSize="17"
                    Foreground="White"
                    HorizontalAlignment="Right"
                    />
            </StackPanel>
        </Grid>

        <Grid x:Name="ImportRejectDialogOverlay"
              Visibility="Collapsed"
              Opacity="0"
              Background="#99000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFE0E0E0"
                    BorderBrush="#FF303030"
                    BorderThickness="2"
                    Padding="24">
                <StackPanel>
                    <TextBlock x:Name="ImportRejectDialogTitle"
                               Text=""
                               Foreground="#FF101010"
                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ImportRejectDialogMessage"
                               Text=""
                               Foreground="#FF202020"
                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                               FontSize="18"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <Button x:Name="ImportRejectDialogOkButton"
                            Content="OK"
                            Click="OnRejectDialogOkClick"
                            FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft"
                            FontSize="18"
                            Foreground="#FF101010"
                            Width="180"
                            Height="56"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

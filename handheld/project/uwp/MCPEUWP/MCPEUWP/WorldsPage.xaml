<Page
    x:Class="MCPEUWP.WorldsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#202838">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="BackButton" Content="Back" Click="OnBackClick" MinWidth="96" Margin="0,0,16,0" />
            <TextBlock Text="Singleplayer" Foreground="White" FontSize="28" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,24">
            <ListView x:Name="WorldList"
                      SelectionChanged="OnWorldSelected"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
            <TextBlock x:Name="EmptyText"
                       Text="No saved worlds yet."
                       Foreground="#FFD8C0"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="StatusText"
                       Text="Loading saved worlds..."
                       Foreground="#FFD8C0"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <Button x:Name="CreateWorldButton"
                    Content="Create New World"
                    Click="OnCreateWorldClick"
                    HorizontalAlignment="Left"
                    MinWidth="180" />
        </StackPanel>
    </Grid>
</Page>

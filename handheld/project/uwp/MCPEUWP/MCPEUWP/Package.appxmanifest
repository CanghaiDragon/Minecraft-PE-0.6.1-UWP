<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="a9e259b9-3d19-49ed-86a7-9b072b11c8b8"
    Publisher="CN=CHLoong"
    Version="1.9.12.0" />

  <mp:PhoneIdentity PhoneProductId="a9e259b9-3d19-49ed-86a7-9b072b11c8b8" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Minecraft PE 0.6.1</DisplayName>
    <PublisherDisplayName>dufu2</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="MCPEUWP.App">
      <uap:VisualElements
        DisplayName="Minecraft PE 0.6.1"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="MCPE 0.6.1 UWP ANGLE platform shell"
        BackgroundColor="#FFFFFF">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png"
                          Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- RakNet host mode needs inbound LAN connections in addition to the
         existing outbound discovery/join capability. -->
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="internetClientServer" />
  </Capabilities>
</Package>

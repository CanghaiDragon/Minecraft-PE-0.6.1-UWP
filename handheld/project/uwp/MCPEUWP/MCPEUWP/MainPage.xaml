<Page
    x:Class="MCPEUWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MCPEUWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#FF101010">
        <Grid.Resources>
            <Style x:Key="DirtShadeRectangle" TargetType="Rectangle">
                <Setter Property="Fill" Value="#18000000" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style x:Key="DirtOverlayRectangle" TargetType="Rectangle">
                <Setter Property="Fill" Value="#55000000" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Grid.Resources>
        <SwapChainPanel x:Name="AnglePanel" />

        <!-- ARM32-only XAML reachability probe.  It is independent of the
             SwapChainPanel and remains above the game surface. -->
        <Border x:Name="Arm32XamlProbe"
                Canvas.ZIndex="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,36,0,0"
                Padding="18,10"
                Background="#EE202020"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="XAML_RUNTIME_MARKER_1934"
                           Foreground="#FFFF0000"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="XAML MAIN PAGE LOADED"
                           Foreground="#FFFFFF00"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="Arm32StartupStage"
                           Foreground="White"
                           FontSize="14"
                           TextWrapping="Wrap"
                           MaxWidth="900"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- The original MCPE menu opens this native UWP surface through the
             bridge.  Keeping it as an overlay leaves the original menu and
             game loop alive underneath, so returning to the menu is instant. -->
        <Grid x:Name="SkinOverlay"
              Canvas.ZIndex="200"
              Visibility="Collapsed"
              Background="Transparent">
            <Canvas x:Name="SkinDirtBackground"
                    SizeChanged="OnSkinBackgroundSizeChanged"
                    IsHitTestVisible="False" />
            <Rectangle Style="{StaticResource DirtShadeRectangle}" />
            <Rectangle Style="{StaticResource DirtOverlayRectangle}" />
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="24,18,24,16"
                    Background="Transparent"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Skin"
                               Foreground="White"
                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center"
                                    MaxWidth="620">
                            <Grid HorizontalAlignment="Stretch"
                                  Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="140"
                                        Height="140"
                                    Background="#FF101010"
                                    BorderBrush="#FF606060"
                                    BorderThickness="1"
                                    Padding="8">
                                    <Image x:Name="SkinPreview"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="Arm Type"
                                               Foreground="White"
                                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont"
                                               FontSize="16"
                                               Margin="0,0,0,8" />
                                    <ComboBox x:Name="SkinArmTypeComboBox"
                                              FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont"
                                              SelectedIndex="0"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnSkinArmTypeChanged">
                                        <ComboBoxItem Content="Classic"
                                                      FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont" />
                                        <ComboBoxItem Content="Slim"
                                                      FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont" />
                                    </ComboBox>
                                    <TextBlock Text="Use a 64x64 PNG skin."
                                               Foreground="#FFB0B0B0"
                                               FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont"
                                               TextWrapping="Wrap"
                                               Margin="0,14,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="SkinStatusText"
                                       Foreground="#FFFFD080"
                                       FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,12" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2"
                          HorizontalAlignment="Stretch"
                          MaxWidth="720"
                          Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Import Skin"
                                Grid.Column="0"
                                Click="OnSkinImportClick"
                                FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont"
                                Height="64"
                                FontSize="16"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,6,0" />
                        <Button Content="Clear Skin"
                                Grid.Column="1"
                                Click="OnSkinClearClick"
                                FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont"
                                Height="64"
                                FontSize="16"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                Margin="6,0,6,0" />
                        <Button Content="Back"
                                Grid.Column="2"
                                Click="OnSkinBackClick"
                                FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft,ms-appx:///data/fonts/unifont-18.0.01.otf#Unifont"
                                Height="64"
                                FontSize="16"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                Margin="6,0,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="KeyMappingOverlay"
              Canvas.ZIndex="210"
              Visibility="Collapsed"
              Background="Transparent">
            <Canvas x:Name="KeyMappingDirtBackground"
                    SizeChanged="OnSkinBackgroundSizeChanged"
                    IsHitTestVisible="False" />
            <Rectangle Style="{StaticResource DirtShadeRectangle}" />
            <Rectangle Style="{StaticResource DirtOverlayRectangle}" />
            <Frame x:Name="KeyMappingFrame"
                   Background="Transparent" />
        </Grid>

        <Grid x:Name="SettingsOverlay" Canvas.ZIndex="215" Visibility="Collapsed" Background="Transparent">
            <Canvas x:Name="SettingsDirtBackground" SizeChanged="OnSkinBackgroundSizeChanged" IsHitTestVisible="False" />
            <Rectangle Style="{StaticResource DirtShadeRectangle}" />
            <Rectangle Style="{StaticResource DirtOverlayRectangle}" />
            <Frame x:Name="SettingsFrame" Background="Transparent" />
        </Grid>

        <Grid x:Name="WorldEditOverlay"
              Canvas.ZIndex="220"
              Visibility="Collapsed"
              Background="Transparent">
            <Canvas x:Name="WorldEditDirtBackground"
                    SizeChanged="OnSkinBackgroundSizeChanged"
                    IsHitTestVisible="False" />
            <Rectangle Style="{StaticResource DirtShadeRectangle}" />
            <Rectangle Style="{StaticResource DirtOverlayRectangle}" />
            <Frame x:Name="WorldEditFrame"
                   Background="Transparent" />
        </Grid>
        <Grid x:Name="WorldImportOverlay"
              Canvas.ZIndex="230"
              Visibility="Collapsed"
              Background="Transparent">
            <Canvas x:Name="WorldImportDirtBackground"
                    SizeChanged="OnSkinBackgroundSizeChanged"
                    IsHitTestVisible="False" />
            <Rectangle Style="{StaticResource DirtShadeRectangle}" />
            <Rectangle Style="{StaticResource DirtOverlayRectangle}" />
            <Frame x:Name="WorldImportFrame"
                   Background="Transparent" />
        </Grid>

    </Grid>
</Page>

<Page x:Class="MCPEUWP.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent" IsTabStop="True" KeyDown="OnPageKeyDown"
    RequestedTheme="Dark"
    FontFamily="ms-appx:///data/fonts/minecraft.ttf#Minecraft">
    <Page.Resources>
        <Style x:Key="McButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="ms-appx:///data/fonts/minecraft.ttf#Minecraft" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="McComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="ms-appx:///data/fonts/minecraft.ttf#Minecraft" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="McComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="ms-appx:///data/fonts/minecraft.ttf#Minecraft" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="McTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="ms-appx:///data/fonts/minecraft.ttf#Minecraft" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="McCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="ms-appx:///data/fonts/minecraft.ttf#Minecraft" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="McSliderStyle" TargetType="Slider">
            <Setter Property="FontFamily" Value="ms-appx:///data/fonts/minecraft.ttf#Minecraft" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Page.Resources>
    <Grid>
        <Rectangle Fill="#33000000" IsHitTestVisible="False" />
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Options" Foreground="White" FontSize="30" HorizontalAlignment="Center" Margin="0,18,0,14"/>
        <Grid Grid.Row="1" Margin="24,0,24,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#AA3A3A3A" Padding="8,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Style="{StaticResource McButtonStyle}" Content="Game" Click="OnGameCategoryClick" Width="174" Foreground="White" FontSize="19" Height="54" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource McButtonStyle}" Content="Controls" Click="OnControlsCategoryClick" Width="174" Foreground="White" FontSize="19" Height="54" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource McButtonStyle}" Content="Graphics" Click="OnGraphicsCategoryClick" Width="174" Foreground="White" FontSize="19" Height="54" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource McButtonStyle}" Content="Audio" Click="OnAudioCategoryClick" Width="174" Foreground="White" FontSize="19" Height="54" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource McButtonStyle}" Content="Additional" Click="OnAdditionalCategoryClick" Width="174" Foreground="White" FontSize="19" Height="54"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="#AA303030" Padding="20,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OptionsPanels">
                        <Border x:Name="GamePanel" Visibility="Visible">
                        <StackPanel>
                        <TextBlock Text="Game" Foreground="White" FontSize="24" Margin="0,0,0,12"/>
                        <TextBox Style="{StaticResource McTextBoxStyle}" x:Name="UsernameBox" Header="Username" PlaceholderText="Username" Foreground="White" Margin="0,4" LostFocus="OnUsernameLostFocus"/>
                        <ComboBox Style="{StaticResource McComboBoxStyle}" x:Name="DifficultyComboBox" Header="Difficulty" Foreground="White" SelectedIndex="0" Margin="0,4" SelectionChanged="OnOptionSelectionChanged"><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Peaceful" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Normal" Foreground="White"/></ComboBox>
                        <ComboBox Style="{StaticResource McComboBoxStyle}" x:Name="CameraComboBox" Header="Camera" Foreground="White" SelectedIndex="0" Margin="0,4" SelectionChanged="OnOptionSelectionChanged"><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="First Person" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Third Person Back" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Third Person Front" Foreground="White"/></ComboBox>
                        <CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="ServerVisibleCheckBox" Content="Open to LAN by Default" Foreground="White" Margin="0,8,0,0" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/>
                        <ComboBox Style="{StaticResource McComboBoxStyle}" x:Name="DynamicTileComboBox" Header="Dynamic Tile (Win10 only)" Foreground="White" SelectedIndex="0" Margin="0,4" SelectionChanged="OnOptionSelectionChanged"><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Off" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Simple" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Full" Foreground="White"/></ComboBox>
                        </StackPanel>
                        </Border>
                        <Border x:Name="ControlsPanel" Visibility="Collapsed">
                        <StackPanel>
                        <TextBlock Text="Controls" Foreground="White" FontSize="22" Margin="0,24,0,8"/>
                        <ComboBox Style="{StaticResource McComboBoxStyle}" x:Name="InputModeComboBox" Header="Input Mode" Foreground="White" SelectedIndex="0" Visibility="Collapsed" Margin="0,4" SelectionChanged="OnOptionSelectionChanged"><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Keyboard &amp; Mouse" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Touch" Foreground="White"/></ComboBox>
                        <Slider Style="{StaticResource McSliderStyle}" x:Name="SensitivitySlider" Header="Sensitivity" Minimum="0" Maximum="100" Value="50" Margin="0,4" ValueChanged="OnOptionSliderChanged"/>
                        <ComboBox Style="{StaticResource McComboBoxStyle}" x:Name="DpadSizeComboBox" Header="D-Pad Size" Foreground="White" SelectedIndex="1" Margin="0,4" SelectionChanged="OnOptionSelectionChanged"><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Small" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Normal" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Large" Foreground="White"/></ComboBox>
                        <CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="LeftHandedCheckBox" Content="Left-Handed Controls" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="SplitTouchCheckBox" Content="Split Touch Controls" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="InvertMouseCheckBox" Content="Invert Mouse" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="DestroyVibrationCheckBox" Content="Vibrate on Destroy" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/>
                        </StackPanel>
                        </Border>
                        <Border x:Name="GraphicsPanel" Visibility="Collapsed">
                        <StackPanel>
                        <TextBlock Text="Graphics" Foreground="White" FontSize="22" Margin="0,24,0,8"/>
                        <ComboBox Style="{StaticResource McComboBoxStyle}" x:Name="GraphicsModeComboBox" Header="Graphics" Foreground="White" SelectedIndex="0" Margin="0,4" SelectionChanged="OnOptionSelectionChanged"><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Fancy" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Fast" Foreground="White"/></ComboBox>
                        <CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="AmbientOcclusionCheckBox" Content="Smooth Lighting" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/>
                        <ComboBox Style="{StaticResource McComboBoxStyle}" x:Name="RenderDistanceComboBox" Header="Render Distance" Foreground="White" SelectedIndex="2" Margin="0,4" SelectionChanged="OnOptionSelectionChanged"><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Tiny" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Short" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Normal" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Far" Foreground="White"/></ComboBox>
                        <ComboBox Style="{StaticResource McComboBoxStyle}" x:Name="GuiScaleComboBox" Header="GUI Scale" Foreground="White" SelectedIndex="0" Margin="0,4" SelectionChanged="OnOptionSelectionChanged"><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Auto" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Small" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Medium" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Normal" Foreground="White"/><ComboBoxItem Style="{StaticResource McComboBoxItemStyle}" Content="Large" Foreground="White"/></ComboBox>
                        <Slider Style="{StaticResource McSliderStyle}" x:Name="FieldOfViewSlider" Header="Field of View" Minimum="30" Maximum="110" Value="70" Margin="0,4" ValueChanged="OnOptionSliderChanged"/>
                        <CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="ViewBobbingCheckBox" Content="View Bobbing" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="HideGuiCheckBox" Content="Hide HUD" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/>
                        </StackPanel>
                        </Border>
                        <Border x:Name="AudioPanel" Visibility="Collapsed">
                        <StackPanel>
                        <TextBlock Text="Audio" Foreground="White" FontSize="22" Margin="0,24,0,8"/>
                        <Slider Style="{StaticResource McSliderStyle}" x:Name="MusicSlider" Header="Music" Minimum="0" Maximum="100" Value="80" Margin="0,4" ValueChanged="OnOptionSliderChanged"/><Slider Style="{StaticResource McSliderStyle}" x:Name="SoundSlider" Header="Sound" Minimum="0" Maximum="100" Value="80" Margin="0,4" ValueChanged="OnOptionSliderChanged"/>
                        </StackPanel>
                        </Border>
                        <Border x:Name="AdditionalPanel" Visibility="Collapsed">
                        <StackPanel>
                        <TextBlock Text="Additional" Foreground="White" FontSize="22" Margin="0,24,0,8"/>
                        <CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="InfiniteWorldsCheckBox" Content="Extra World Type" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="JavaUiCheckBox" Content="Java UI" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="SkinMenuCheckBox" Content="Optimized Skin" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="TouchSneakCheckBox" Content="Touch Sneak" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="BetaVisualsCheckBox" Content="Java Beta Graphic Visual" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/><CheckBox Style="{StaticResource McCheckBoxStyle}" x:Name="DebugScreenCheckBox" Content="Debug Screen F3" Foreground="White" Checked="OnOptionCheckBoxChanged" Unchecked="OnOptionCheckBoxChanged"/>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,20">
            <Button Style="{StaticResource McButtonStyle}" Content="Restore Default Settings" Foreground="White" Width="240" Height="54" Margin="0,0,12,0" Click="OnRestoreDefaultsClick"/>
            <Button Style="{StaticResource McButtonStyle}" Content="Back" Foreground="White" Width="150" Height="54" Click="OnBackClick"/>
        </StackPanel>
        </Grid>
    </Grid>
</Page>
